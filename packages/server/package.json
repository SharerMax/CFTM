    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@cftm/shared": "workspace:*",
    "@hono/node-server": "catalog:",
    "@prisma/adapter-better-sqlite3": "catalog:",
    "@prisma/client": "catalog:",
    "better-sqlite3": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
